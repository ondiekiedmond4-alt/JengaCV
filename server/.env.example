# Postgres connection string (Render provides this automatically if you use render.yaml)
DATABASE_URL=postgres://user:password@host:5432/jengacv

# Safaricom Daraja API — get these from https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your_passkey
DARAJA_ENV=sandbox

# Pesapal API v3 (card payments) — get these from https://developer.pesapal.com
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENV=sandbox
# Optional: set this after your first successful IPN registration to skip
# re-registering on every server restart (the server logs the ipn_id it gets).
PESAPAL_IPN_ID=

# Must be a public HTTPS URL Safaricom can reach — your deployed Render URL.
# Example: https://jengacv.onrender.com
CALLBACK_BASE_URL=https://your-deployed-url.onrender.com

PORT=3000
