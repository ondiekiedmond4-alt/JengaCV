# Postgres connection string (Render provides this automatically if you use render.yaml)
DATABASE_URL=postgres://user:password@host:5432/jengacv

# Safaricom Daraja API — get these from https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your_passkey
DARAJA_ENV=sandbox

# Pesapal API v3 (card payments) — get these from https://developer.pesapal.com
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENV=sandbox
# Optional: set this after your first successful IPN registration to skip
# re-registering on every server restart (the server logs the ipn_id it gets).
PESAPAL_IPN_ID=

# Must be a public HTTPS URL Safaricom can reach — your deployed Render URL.
# Example: https://jengacv.onrender.com
CALLBACK_BASE_URL=https://your-deployed-url.onrender.com

# Secret used to sign login session tokens. Use a long random string —
# generate one locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Resend (email) — get an API key from https://resend.com after signing up.
# Without RESEND_API_KEY set, emails are skipped (logged, not sent) so the
# rest of the app keeps working — but password resets and promo emails
# won't actually reach anyone until this is configured.
RESEND_API_KEY=
# "onboarding@resend.dev" works immediately without verifying a domain, but
# only for testing — set this to your own verified domain before real use.
EMAIL_FROM=JengaCV <onboarding@resend.dev>

# Anthropic API key for AI CV proofreading — get one at https://console.anthropic.com
# Without this set, the "Improve with AI" feature returns a clear error
# instead of crashing; everything else in the app keeps working.
ANTHROPIC_API_KEY=

# CustomJS (server-side PDF generation) — get a free API key at
# https://www.customjs.space (600 free PDF conversions/month). Without
# this set, downloads will show a clear error instead of crashing.
CUSTOMJS_API_KEY=

PORT=3000
